# 应用
APP_NAME=nexus-agent
API_PREFIX=/api

# PostgreSQL 数据库（异步驱动 asyncpg）
DATABASE_URI=postgresql+asyncpg://root:123456@localhost:5432/nexus_agent
DB_ECHO=false

# JWT
JWT_SECRET_KEY=please-change-this-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# MinIO / S3 对象存储
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Admin123456
MINIO_BUCKET=nexus-agent

# Weaviate 向量数据库
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=sk-1234567890

# Redis（embedding 向量缓存 + 分布式锁）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# 本地 Embedding 模型（首次调用会自动下载）
EMBEDDING_MODEL_NAME=Alibaba-NLP/gte-multilingual-base
HF_ENDPOINT=https://hf-mirror.com

# LLM 大语言模型（兼容 OpenAI API 格式，支持 DeepSeek / 通义千问 / 智谱 GLM 等）
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash
